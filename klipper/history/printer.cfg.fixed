# --- Custom 20x4 Home Screen Layout (Overrides _default_20x4) ---



# Row 0 Left: Hotend Temp + Target

[display_data _default_20x4 extruder]

position: 0, 0

text: { render("_heater_temperature", param_heater_name="extruder") }



# Row 0 Right: Bed Temp + Animated Heating + Target

[display_data _default_20x4 heater_bed]

position: 0, 10

text: { render("_heater_temperature", param_heater_name="heater_bed") }



# Row 1 Left: Live Z Height + Homed Indicator (replaces unused extruder1 slot!)

[display_data _default_20x4 extruder1]

position: 1, 0

text:

~z_height~

{% if "z" in printer.toolhead.homed_axes %}

{ "%6.2fmm" % (printer.gcode_move.gcode_position.z,) }

{% else %}

{ "  ---   " }

{% endif %}



# Row 1 Right: Animated Cooling Fan + Filament Sensor Indicator

[display_data _default_20x4 fan]

position: 1, 10

text:

{% if 'fan' in printer %}

{% set speed = printer.fan.speed %}

{% if speed > 0.0 %}

{% set frame = (printer.toolhead.estimated_print_time|int % 2) + 1 %}

~fan{frame}~

{% else %}

~fan1~

{% endif %}

{ "{:>4.0%} ".format(speed) }

{% endif %}

~filament~

{% if printer["filament_switch_sensor fsensor"].filament_detected %}

{ "OK" }

{% else %}

{ "--" }

{% endif %}



# Row 2 Left: Feedrate %

[display_data _default_20x4 speed_factor]

position: 2, 0

text:

~feedrate~

{ "{:>4.0%}".format(printer.gcode_move.speed_factor) }



# Row 2 Center: Print Progress % OR Live Layer Counter (Cycles every 4s while printing!)

[display_data _default_20x4 print_progress]

position: 2, 6

text:

{% if printer.idle_timeout.state == "Printing" and printer.print_stats.info.total_layer %}

{% if (printer.toolhead.estimated_print_time|int % 6) < 3 %}

{ "L{:>3d}/{:<3d}".format(printer.print_stats.info.current_layer|default(0)|int, printer.print_stats.info.total_layer|int) }

{% else %}

{ "  {:^4.0%}  ".format(printer.display_status.progress) }

{% endif %}

{% else %}

{ "  {:^4.0%}  ".format(printer.display_status.progress) }

{% endif %}



# Row 2 Right: Print Elapsed Time

[display_data _default_20x4 printing_time]

position: 2, 14

text:

~clock~

{ render("_printing_time") }



# Row 3 Full 20-Char Smart Status Bar

[display_data _default_20x4 print_status]

position: 3, 0

text:

{% if printer.display_status.message %}

{ "%-20.20s" % (printer.display_status.message,) }

{% elif printer.idle_timeout.printing_time %}

{% set pos = printer.gcode_move.gcode_position %}

{% set spd = printer.motion_report.live_velocity|default(0.0) %}

{ "X%-3.0f Y%-3.0f %4.0fmm/s" % (pos.x, pos.y, spd) }

{% else %}

{% set pi_temp = printer["temperature_sensor raspberry_pi"].temperature|default(0.0) %}

{ "MK3S Bear  Pi:%4.1fC" % (pi_temp,) }

{% endif %}



# ==============================================================================

# Custom 2004 LCD Menu Items (BMG Load/Unload, Bear Z-Align, Preheats, Cleanups)

# ==============================================================================



# Hide obsolete OctoPrint and ABS menus

[menu __main __octoprint]

type: list

enable: False

name: OctoPrint



[menu __main __temp __preheat_abs]

type: list

enable: False

name: Preheat ABS



# Upgrade built-in Preheat PLA to your 195/55 Sunlu PLA Meta settings

[menu __main __temp __preheat_pla __all]

type: command

enable: {('extruder' in printer) and ('heater_bed' in printer)}

name: Preheat all (195/55)

gcode:

M140 S55

M104 S195



[menu __main __temp __preheat_pla __hotend]

type: command

enable: {'extruder' in printer}

name: Preheat hotend (195)

gcode: M104 S195



[menu __main __temp __preheat_pla __hotbed]

type: command

enable: {'heater_bed' in printer}

name: Preheat hotbed (55)

gcode: M140 S55



# Add Preheat PETG under Temperature menu

[menu __main __temp __preheat_petg]

type: list

name: Preheat PETG



[menu __main __temp __preheat_petg __all]

type: command

enable: {('extruder' in printer) and ('heater_bed' in printer)}

name: Preheat all (240/85)

gcode:

M140 S85

M104 S240



[menu __main __temp __preheat_petg __hotend]

type: command

enable: {'extruder' in printer}

name: Preheat hotend (240)

gcode: M104 S240



[menu __main __temp __preheat_petg __hotbed]

type: command

enable: {'heater_bed' in printer}

name: Preheat hotbed (85)

gcode: M140 S85



# Fix built-in Filament Menu to use BMG LOAD_FILAMENT / UNLOAD_FILAMENT macros

[menu __main __filament __loadf]

type: command

name: Load Filament (BMG)

gcode:

LOAD_FILAMENT



[menu __main __filament __loads]

type: command

enable: False

name: Load Fil. slow

gcode:



[menu __main __filament __unloadf]

type: command

name: Unload Fil. (BMG)

gcode:

UNLOAD_FILAMENT



[menu __main __filament __unloads]

type: command

enable: False

name: Unload Fil.slow

gcode:



[menu __main __filament __purge]

type: command

name: Purge 25mm

gcode:

SAVE_GCODE_STATE NAME=__filament__load

M83

G1 E25 F300

RESTORE_GCODE_STATE NAME=__filament__load



# Top-Level Bear & BMG Quick Menu (Index 1 - right at the top!)

[menu __main __bear]

type: list

name: Bear & BMG Tools

index: 1



[menu __main __bear __z_align]

type: command

name: Bear Z-Align

gcode:

Z_ALIGN_BEAR



[menu __main __bear __load_fil]

type: command

name: Load Filament (BMG)

gcode:

LOAD_FILAMENT



[menu __main __bear __unload_fil]

type: command

name: Unload Fil. (BMG)

gcode:

UNLOAD_FILAMENT



[menu __main __bear __preheat_pla]

type: command

name: Preheat PLA 195/55

gcode:

M140 S55

M104 S195



[menu __main __bear __preheat_petg]

type: command

name: Preheat PETG 240/85

gcode:

M140 S85

M104 S240



[menu __main __bear __cooldown]

type: command

name: Cooldown All

gcode:

TURN_OFF_HEATERS



# ==============================================================================

# Useful Features & Macros (Mainsail & OrcaSlicer Optimized)

# ==============================================================================



[exclude_object]

[gcode_arcs]

resolution: 0.1

[skew_correction]

[force_move]

enable_force_move: True

[respond]

[pause_resume]



# ==============================================================================

# Prusa MK3S Optical Filament Runout Sensor (Einsy pin PK0)

# ==============================================================================



[filament_switch_sensor fsensor]

pause_on_runout: False

runout_gcode:

M117 Filament Runout Detected!

M300 S1000 P200

G4 P100

M300 S1500 P300

insert_gcode:

M117 Filament Inserted

M300 S1500 P150

switch_pin: ^!PK0

[display_status]



[gcode_macro M300]

description: Play tone on LCD beeper

gcode:

{% set S = params.S|default(1000)|int %}

{% set P = params.P|default(100)|int %}

SET_PIN PIN=BEEPER_pin VALUE=0.5 CYCLE_TIME={ 1.0/S if S > 0 else 1 }

G4 P{P}

SET_PIN PIN=BEEPER_pin VALUE=0



[gcode_macro M600]

description: Prusa style M600 Filament Change (Parks front-right at Z>=50mm and unloads)

gcode:

M300 S1500 P200

G4 P100

M300 S2000 P300

PAUSE X=240 Y=0 Z_MIN=50



[gcode_macro M900]

description: Translate Marlin Linear Advance (M900 Kxx) to Klipper Pressure Advance

gcode:

{% if 'K' in params %}

SET_PRESSURE_ADVANCE ADVANCE={params.K|float}

{% endif %}



[gcode_macro G80]

description: Legacy Prusa G80 mesh leveling alias

gcode:

BED_MESH_CALIBRATE ADAPTIVE=1



[gcode_macro START_PRINT]

description: Prusa MK3S Bear + BMG No-Ooze Start Print Macro (Clean KAMP Integration)

gcode:

{% set BED_TEMP = params.BED_TEMP|default(60)|float %}

{% set EXTRUDER_TEMP = params.EXTRUDER_TEMP|default(215)|float %}

{% set PA = params.PA|default(0.045)|float %}



G90 ; Absolute coordinates

M83 ; Extruder relative mode

M220 S100 ; Reset speed factor to 100%

M221 S100 ; Reset flow factor to 100%

SET_PRESSURE_ADVANCE ADVANCE={PA}



; --- 1. PREHEAT BED & STANDBY NOZZLE (NO OOZE) ---

M117 Preheating Bed...

M104 S160 ; Warm nozzle to 160C (stops drip during bed probing)

M140 S{BED_TEMP}

M190 S{BED_TEMP}



; --- 2. CALIBRATION (HOME + KAMP ADAPTIVE MESH) ---

M117 Homing & Adaptive Mesh...

G28

BED_MESH_CLEAR

BED_MESH_CALIBRATE ; KAMP automatically intercepts this and probes ONLY the model area!



; --- 3. SMART PARK & FINAL HEATING ---

M117 Heating Nozzle...

Smart_Park ; KAMP parks nozzle 3mm above bed right next to the print area

M109 S{EXTRUDER_TEMP}

M300 S1200 P80 ; Ready beep



; --- 4. KAMP ADAPTIVE LINE PURGE ---

M117 Adaptive Purge...

LINE_PURGE ; KAMP adaptive purge right in front of the part

M117 Printing...



[gcode_macro PID_HOTEND]

description: Quick PID tune for E3D V6 Hotend (default 215C)

gcode:

{% set TEMP = params.TEMP|default(215)|float %}

M106 S64 ; 25% part fan during PID for realistic printing conditions

PID_CALIBRATE HEATER=extruder TARGET={TEMP}

M107

SAVE_CONFIG



[gcode_macro PID_BED]

description: Quick PID tune for MK52 Heatbed (default 60C)

gcode:

{% set TEMP = params.TEMP|default(60)|float %}

PID_CALIBRATE HEATER=heater_bed TARGET={TEMP}

SAVE_CONFIG



[gcode_macro END_PRINT]

description: Prusa MK3S Bear + BMG Smart End Print Macro

gcode:

{% set max_z = printer.toolhead.axis_maximum.z|float %}

{% set act_z = printer.toolhead.position.z|float %}

{% set lift_z = [act_z + 48.0, max_z]|min %}



M400 ; Wait for all moves in buffer to complete



; --- 1. RETRACT & SAFE CLEARANCE ---

G92 E0

G91 ; Relative positioning

G1 E-0.8 F2400 ; Retract 0.8mm to prevent cold heatbreak neck plugs

G1 Z{ [2.0, max_z - act_z]|min } F720 ; Immediate 2mm hop off the model

G90 ; Return to absolute positioning



; --- 2. PRESENT PART & COOLDOWN ---

TURN_OFF_HEATERS ; Turn off hotend & bed heaters immediately

M107 ; Turn off part cooling fan

G1 X0 Y200 F3600 ; Park carriage left and push bed forward for easy removal

G1 Z{lift_z} F720 ; Lift gantry up (+48mm up to 210mm Bear limit) for clearance



; --- 3. RESET MODES & MOTORS ---

M221 S100 ; Reset flow multiplier to 100%

M220 S100 ; Reset speed multiplier to 100%

SET_PRESSURE_ADVANCE ADVANCE=0.045 ; Reset PA to baseline

M84 ; Disable stepper motors

M300 S1000 P120 ; Print finished chime

G4 P80

M300 S1500 P200

M117 Print Complete!



[gcode_macro LOAD_FILAMENT]

description: Load and purge filament through Bondtech BMG (3:1) + E3D V6

gcode:

{% set target_temp = params.TEMP|default(printer.extruder.target)|float %}

{% set load_temp = [target_temp, 190.0]|max if target_temp > 0 else 190.0 %}

{% if printer.extruder.temperature < (load_temp - 5) %}

M117 Heating to {load_temp}C...

M109 S{load_temp}

{% endif %}

M117 Loading Filament...

M83

G1 E45 F600 ; Fast load through BMG gears into V6 heatbreak

G1 E35 F200 ; Slow purge through 0.4mm nozzle

G1 E-0.8 F1800 ; Small retract to stop ooze

M400

M300 S1500 P150

M117 Filament Loaded!



[gcode_macro UNLOAD_FILAMENT]

description: Tip-shaping unload for Bondtech BMG + E3D V6 All-Metal

gcode:

{% set target_temp = params.TEMP|default(printer.extruder.target)|float %}

{% set unload_temp = [target_temp, 190.0]|max if target_temp > 0 else 190.0 %}

{% if printer.extruder.temperature < (unload_temp - 5) %}

M117 Heating to {unload_temp}C...

M109 S{unload_temp}

{% endif %}

M117 Unloading Filament...

M83

G1 E5 F300 ; Extrude slightly to melt tip

G1 E-15 F3000 ; Fast jerk out of meltzone to form clean tip

G4 P2000 ; Cool tip for 2s in heatbreak

G1 E-65 F1200 ; Retract completely out of Bondtech BMG gears

M400

M300 S1200 P150

M117 Filament Unloaded!



[gcode_macro Z_ALIGN_BEAR]

description: Mechanical Gantry Calibration against top Z-tops (Prusa Bear 210mm style)

gcode:

{% if xyz not in printer.toolhead.homed_axes %}

G28

{% endif %}

M117 Aligning Bear Z...

G90

G1 X125 Y105 F3000

G1 Z208 F1000

SET_TMC_CURRENT STEPPER=stepper_z CURRENT=0.18

FORCE_MOVE STEPPER=stepper_z DISTANCE=6 VELOCITY=4

G4 P300

FORCE_MOVE STEPPER=stepper_z DISTANCE=-6 VELOCITY=10

SET_TMC_CURRENT STEPPER=stepper_z CURRENT=0.53033

G28 Z

M300 S1500 P150

M117 Bear Z Aligned!



