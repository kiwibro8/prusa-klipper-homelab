# ==============================================================================

# Prusa i3 MK3S (Bear 2.1 Frame + Bondtech BMG + E3D V6) - Klipper Configuration

# Board: Ultimachine Einsy RAMBo 1.1a (ATmega2560 @ 16MHz, UART0)

# Host: Raspberry Pi 4 (4GB) running Klipper + Moonraker + Mainsail

# ==============================================================================



[include mainsail.cfg]

[include KAMP_Settings.cfg]



# ==============================================================================

# Mainsail Client Variables (Safe E3D V6 Retract, Front-Right Swap Park, Sensor Guard)

# ==============================================================================



[gcode_macro _CLIENT_VARIABLE]

variable_use_custom_pos   : True  ; use custom park coordinates for x,y

variable_custom_park_x    : 240.0 ; park at far right for easy filament swap & purge

variable_custom_park_y    : 0.0   ; park at front so you can reach the BMG lever easily

variable_custom_park_dz   : 15.0  ; lift nozzle 15mm on pause for clean access

variable_retract          : 0.8   ; 0.8mm retract on pause (safe for E3D V6 all-metal)

variable_cancel_retract   : 0.8   ; 0.8mm retract on cancel (prevents 5mm heatbreak jam!)

variable_speed_retract    : 35.0  ; retract speed in mm/s

variable_unretract        : 0.8   ; 0.8mm unretract on resume

variable_speed_unretract  : 35.0  ; unretract speed in mm/s

variable_speed_hop        : 15.0  ; z move speed in mm/s

variable_speed_move       : 100.0 ; park move speed in mm/s

variable_park_at_cancel   : True  ; automatically park toolhead and present bed when cancelling

variable_park_at_cancel_x : 0.0   ; park carriage left on cancel

variable_park_at_cancel_y : 200.0 ; push bed forward on cancel

variable_use_fw_retract   : True  ; use firmware retraction

variable_idle_timeout     : 43200 ; keep bed warm for up to 12 hours when paused for filament runout!

variable_runout_sensor    : "filament_switch_sensor fsensor" ; block RESUME if filament is still empty!

gcode:



[gcode_macro SEARCH_VARS]

description: Search Klipper state variables (Usage: SEARCH_VARS S="extruder")

gcode:

{% set search = params.S|lower %}

{% set ns = namespace() %}

{% for item in printer  %}

{% if ' ' in item %}

{% set ns.path = ['printer', "['%s']" % (item), ''] %}

{% else %}

{% set ns.path = ['printer.', item, ''] %}

{% endif %}

{% if search in ns.path|lower %}

{ action_respond_info(ns.path|join) }

{% endif %}

{% if printer[item].items() %}

{% for childkey, child in printer[item].items() recursive %}

{% set ns.path = ns.path[:loop.depth|int + 1] %}

{% if ' ' in childkey %}

{% set null = ns.path.append("['%s']" % (childkey)) %}

{% else %}

{% set null = ns.path.append(".%s" % (childkey)) %}

{% endif %}

{% if child is mapping  %}

{ loop(child.items()) }

{% else %}

{% if search in ns.path|lower %}

{ action_respond_info("%s : %s" % (ns.path|join, child)) }

{% endif %}

{% endif %}

{% endfor %}

{% endif %}

{% endfor %}



[mcu]

serial: /dev/serial/by-id/usb-Prusa_Research__prusa3d.com__Original_Prusa_i3_MK3____________________-if00

restart_method: arduino



[printer]

kinematics: cartesian

max_velocity: 300

max_accel: 3000

max_z_velocity: 12

max_z_accel: 200

square_corner_velocity: 5.0



# ==============================================================================

# X / Y / Z Steppers & Trinamic TMC2130 Hardware SPI Configuration

# ==============================================================================



[stepper_x]

step_pin: PC0

dir_pin: !PL0

enable_pin: !PA7

microsteps: 16

rotation_distance: 32

endstop_pin: tmc2130_stepper_x:virtual_endstop

position_endstop: 0

position_min: 0

position_max: 250

homing_speed: 50

homing_retract_dist: 0



[tmc2130 stepper_x]

cs_pin: PG0

interpolate: True

run_current: 0.281738

hold_current: 0.281738

sense_resistor: 0.220

diag1_pin: !PK2

driver_IHOLDDELAY: 8

driver_TPOWERDOWN: 0

driver_TBL: 2

driver_TOFF: 3

driver_HEND: 1

driver_HSTRT: 5

driver_PWM_FREQ: 2

driver_PWM_GRAD: 2

driver_PWM_AMPL: 230

driver_PWM_AUTOSCALE: True

driver_SGT: 3

stealthchop_threshold: 999999



[stepper_y]

step_pin: PC1

dir_pin: PL1

enable_pin: !PA6

microsteps: 16

rotation_distance: 32

endstop_pin: tmc2130_stepper_y:virtual_endstop

position_endstop: -4

position_min: -4

position_max: 210

homing_speed: 50

homing_retract_dist: 0



[tmc2130 stepper_y]

cs_pin: PG2

interpolate: True

run_current: 0.3480291

hold_current: 0.3480291

sense_resistor: 0.220

diag1_pin: !PK7

driver_IHOLDDELAY: 8

driver_TPOWERDOWN: 0

driver_TBL: 2

driver_TOFF: 3

driver_HEND: 1

driver_HSTRT: 5

driver_PWM_FREQ: 2

driver_PWM_GRAD: 2

driver_PWM_AMPL: 235

driver_PWM_AUTOSCALE: True

driver_SGT: 3

stealthchop_threshold: 999999



[stepper_z]

step_pin: PC2

dir_pin: !PL2

enable_pin: !PA5

microsteps: 16

rotation_distance: 8

endstop_pin: probe:z_virtual_endstop

position_min: -2

position_max: 210

homing_speed: 13.333



[tmc2130 stepper_z]

cs_pin: PK5

interpolate: True

run_current: 0.53033

hold_current: 0.53033

sense_resistor: 0.220

diag1_pin: !PK6

driver_IHOLDDELAY: 8

driver_TPOWERDOWN: 0

driver_TBL: 2

driver_TOFF: 3

driver_HEND: 1

driver_HSTRT: 5

driver_PWM_FREQ: 2

driver_PWM_GRAD: 4

driver_PWM_AMPL: 200

driver_PWM_AUTOSCALE: True

driver_SGT: 4



# ==============================================================================

# Extruder: Bondtech BMG (3:1 Gear Ratio) + Genuine E3D V6 All-Metal (0.4mm)

# ==============================================================================



[extruder]

step_pin: PC3

dir_pin: PL6

enable_pin: !PA4

microsteps: 16

rotation_distance: 7.711

nozzle_diameter: 0.400

filament_diameter: 1.750

max_extrude_only_distance: 200.0

max_extrude_only_velocity: 120.0

max_extrude_only_accel: 1250.0

max_extrude_cross_section: 50.0

heater_pin: PE5

sensor_type: ATC Semitec 104GT-2

sensor_pin: PF0

#control: pid

#pid_Kp: 16.13

#pid_Ki: 1.1625

#pid_Kd: 56.23

min_temp: 0

max_temp: 305

min_extrude_temp: 170

pressure_advance: 0.045

pressure_advance_smooth_time: 0.040



[tmc2130 extruder]

cs_pin: PK4

interpolate: True

run_current: 0.480

sense_resistor: 0.220

diag1_pin: !PK3

driver_IHOLDDELAY: 8

driver_TPOWERDOWN: 0

driver_TBL: 2

driver_TOFF: 3

driver_HEND: 1

driver_HSTRT: 5

driver_PWM_FREQ: 2

driver_PWM_GRAD: 4

driver_PWM_AMPL: 240

driver_PWM_AUTOSCALE: True

driver_SGT: 3



[firmware_retraction]

retract_length: 0.8

retract_speed: 35

unretract_extra_length: 0

unretract_speed: 35



# ==============================================================================

# Prusa MK52 Magnetic Heatbed

# ==============================================================================



[heater_bed]

heater_pin: PG5

sensor_type: EPCOS 100K B57560G104F

sensor_pin: PF2

control: pid

pid_Kp: 126.13

pid_Ki: 4.3

pid_Kd: 924.76

min_temp: 0

max_temp: 125



# ==============================================================================

# SuperPINDA Inductive Probe & 7x7 Bed Mesh Leveling

# ==============================================================================



[probe]

pin: ^PB4

x_offset: 23.0

y_offset: 5.0

z_offset: 0.377

speed: 10.0

samples: 1

sample_retract_dist: 1.0

lift_speed: 15.0



[safe_z_home]

home_xy_position: 102, 100

speed: 50.0

z_hop: 5.0

z_hop_speed: 15.0



[bed_mesh]

speed: 200

horizontal_move_z: 2

mesh_min: 24, 6

mesh_max: 241, 205

probe_count: 7, 7

mesh_pps: 2, 2

algorithm: bicubic

bicubic_tension: 0.2

fade_start: 1.0

fade_end: 10.0

adaptive_margin: 5



[screws_tilt_adjust]

# Coordinates so the SuperPINDA (+23, +5 offset) probes directly over MK52 bed standoffs

screw1: 102, 100

screw1_name: Center (Reference)

screw2: 0, 1

screw2_name: Front Left

screw3: 205, 1

screw3_name: Front Right

screw4: 205, 199

screw4_name: Rear Right

screw5: 0, 199

screw5_name: Rear Left

speed: 150

horizontal_move_z: 5

screw_thread: CCW-M3



[idle_timeout]

timeout: 1800



# ==============================================================================

# Fans & Temperature Sensors (Einsy RAMBo + Raspberry Pi 4)

# ==============================================================================



[heater_fan hotend_fan]

pin: PH5

heater: extruder

heater_temp: 50.0

fan_speed: 1.0

tachometer_pin: ^PE6

tachometer_poll_interval: 0.0015



[fan]

pin: PH3

tachometer_pin: ^PE7

tachometer_poll_interval: 0.0015



[temperature_sensor einsy_board]

sensor_pin: PF6

sensor_type: TDK NTCG104LH104JT1

min_temp: 0

max_temp: 75



[temperature_sensor raspberry_pi]

sensor_type: temperature_host

min_temp: 10

max_temp: 85



# ==============================================================================

# Onboard RepRapDiscount 2004 LCD & Rotary Encoder + Beeper (MK3S Stock LCD)

# ==============================================================================



[display]

lcd_type: hd44780

rs_pin: PD5

e_pin: PF7

d4_pin: PF5

d5_pin: PG4

d6_pin: PH7

d7_pin: PG3

encoder_pins: ^PJ1, ^PJ2

click_pin: ^!PH6

line_length: 20

menu_timeout: 40



[output_pin BEEPER_pin]

pin: PH2

pwm: True

value: 0

shutdown_value: 0

cycle_time: 0.001

scale: 1000



[static_digital_output yellow_led]

pins: !PB7



# ==============================================================================

# TMC Autotune - Optimal Trinamic Register Math for MK3S Bear Steppers

# ==============================================================================



[autotune_tmc stepper_x]

motor: ldo-42sth40-1004a

tuning_goal: silent

sgt: 3



[autotune_tmc stepper_y]

motor: ldo-42sth40-1004a

tuning_goal: silent

sgt: 3



# ==============================================================================

# Custom 2004 LCD UI Dashboard & Menu (Prusa-Inspired Modern Layout)

# ==============================================================================



